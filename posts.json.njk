---
permalink: /posts.json
eleventyExcludeFromCollections: true
---
[{% for post in collections.posts %}{"title":{{ post.data.title | dump | safe }},"url":{{ post.url | dump | safe }},"date":{{ post.date | dateISO | dump | safe }},"description":{{ post.data.description | default("") | dump | safe }},"category":{{ post.data.category | default("") | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]
