---
layout: layouts/base.njk
---
<h1 class="font-typewriter text-2xl font-bold mb-8 pb-4 border-b border-stone-200 dark:border-stone-700">{{ title }}</h1>

{% if category %}
  {% set displayPosts = collections.posts | postsByCategory(category) %}
{% elif tag %}
  {% set displayPosts = collections.postsByTag[tag] %}
{% else %}
  {% set displayPosts = collections.posts %}
{% endif %}

{% if displayPosts.length %}
<ul class="divide-y divide-stone-200 dark:divide-stone-700">
  {% for post in displayPosts %}
  <li class="py-3 flex items-baseline gap-4">
    <time class="font-typewriter text-xs text-stone-400 dark:text-stone-500 whitespace-nowrap shrink-0">{{ post.date | dateISO }}</time>
    <a href="{{ post.url }}" class="font-serif text-ink dark:text-paper hover:text-accent dark:hover:text-accent transition-colors leading-snug">{{ post.data.title }}</a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="text-stone-500 dark:text-stone-400 font-typewriter text-sm">No posts yet.</p>
{% endif %}
