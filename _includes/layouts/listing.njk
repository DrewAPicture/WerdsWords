---
layout: layouts/base.njk
---
<h1>{{ title }}</h1>

{% if posts.length %}
<ul class="post-list">
  {% for post in posts %}
  <li>
    <span class="post-date">{{ post.date | date: "%Y-%m-%d" }}</span>
    {% if post.data.category %}
    <span class="post-category"><a href="/{{ post.data.category }}/">{{ post.data.category }}</a></span>
    {% endif %}
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p>No posts yet.</p>
{% endif %}
