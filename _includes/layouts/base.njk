<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css">
  <script>
    (function () {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="bg-paper dark:bg-ink text-ink dark:text-paper min-h-screen flex flex-col transition-colors duration-200">

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="border-b border-stone-200 dark:border-stone-700 px-6 py-4">
    <nav class="max-w-5xl mx-auto flex items-center justify-between gap-6" aria-label="Site">
      <a href="/" class="font-typewriter text-lg font-bold tracking-tight hover:text-accent dark:hover:text-accent transition-colors shrink-0">{{ site.name }}</a>

      <div class="flex items-center gap-5 flex-wrap">
        <a href="/"
           class="font-typewriter text-sm tracking-wide transition-colors {% if page.url == '/' %}text-accent border-b border-accent pb-px{% else %}text-stone-500 dark:text-stone-400 hover:text-ink dark:hover:text-paper{% endif %}">
          Home
        </a>
        <a href="/about/"
           class="font-typewriter text-sm tracking-wide transition-colors {% if page.url == '/about/' %}text-accent border-b border-accent pb-px{% else %}text-stone-500 dark:text-stone-400 hover:text-ink dark:hover:text-paper{% endif %}">
          About
        </a>
        <a href="/plugins/"
           class="font-typewriter text-sm tracking-wide transition-colors {% if page.url == '/plugins/' %}text-accent border-b border-accent pb-px{% else %}text-stone-500 dark:text-stone-400 hover:text-ink dark:hover:text-paper{% endif %}">
          Plugins
        </a>
        <a href="/conferences/"
           class="font-typewriter text-sm tracking-wide transition-colors {% if page.url == '/conferences/' %}text-accent border-b border-accent pb-px{% else %}text-stone-500 dark:text-stone-400 hover:text-ink dark:hover:text-paper{% endif %}">
          Conferences
        </a>

        <button id="theme-toggle"
                aria-label="Toggle dark mode"
                class="font-typewriter text-sm text-stone-400 hover:text-accent dark:hover:text-accent transition-colors p-1 ml-2">
          <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content" class="flex-1 max-w-2xl mx-auto w-full px-6 py-10">
    {{ content | safe }}
  </main>

  <footer class="border-t border-stone-200 dark:border-stone-700 px-6 py-5 mt-auto">
    <p class="font-typewriter text-xs text-stone-400 dark:text-stone-500 text-center">&copy; {{ site.author }}</p>
  </footer>

  <script>
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>
</body>
</html>
